[Unit]
Description=OfficeChat confirmed production restore request %i
Documentation=file:/opt/officechat/docs/BACKUP_RESTORE_RU.md
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/officechat/restore-request.py %i
TimeoutStartSec=8h
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/officechat /var/lib/officechat-backup-agent/restores /var/backups/officechat /run/lock
StandardOutput=journal
StandardError=journal
